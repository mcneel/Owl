<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <AssemblyName>owl</AssemblyName>
    <RootNamespace>Owl</RootNamespace>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <InvariantGlobalization>true</InvariantGlobalization>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <!-- owl-gen is linked, not spawned: it is a .NET library, so a second process would mean a
         second copy of the runtime in the shipped binary for nothing. -->
    <ProjectReference Include="../owl-gen/Owl.Gen.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- owl-site is embedded because it is JavaScript that node has to require from real files.
         Tools.cs writes these back out at run time. LogicalName always uses forward slashes; the
         RecursiveDir metadata does not, so Tools.cs normalizes before matching.

         Not only the scripts: icons/ is read per kind drawing, lib/vendor/temml.cjs is required by
         math.js, and lib/vendor/temml.css is read as assets.js loads. Every pattern here is a **
         glob so RecursiveDir has a value and a file lands back in the directory it came from.
         VerifySiteEmbedded below fails the build rather than let this list fall behind again. -->
    <EmbeddedResource Include="../owl-site/**/*.js;../owl-site/**/*.cjs;../owl-site/**/*.css;
                               ../owl-site/**/*.svg;../owl-site/**/*.LICENSE;
                               ../owl-site/package.json"
                      Exclude="../owl-site/node_modules/**;../owl-site/dist/**"
                      LogicalName="site/%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

  <!--
    A file owl-site reads at run time but nobody embedded is invisible until the shipped binary is
    run: a dev build resolves it from the source tree and works. That is how icons/, temml.cjs and
    temml.css came to be missing at once. Everything owl-site ships, minus what only a reader needs,
    has to be in the list above.
  -->
  <Target Name="VerifySiteEmbedded" BeforeTargets="Build">
    <ItemGroup>
      <SiteFile Include="../owl-site/**/*"
                Exclude="../owl-site/node_modules/**;../owl-site/dist/**;../owl-site/**/*.md;../owl-site/**/.DS_Store" />
      <SiteUnembedded Include="@(SiteFile)" Exclude="@(EmbeddedResource)" />
    </ItemGroup>
    <Error Condition="'@(SiteUnembedded)' != ''"
           Text="owl-site file(s) not embedded, so the bundled binary would not find them: @(SiteUnembedded). Add the extension to the EmbeddedResource Include in owl/Owl.csproj." />
  </Target>

  <!-- What the package says about itself, whichever way owl is built. -->
  <PropertyGroup>
    <!-- Releases take their version from the git tag (publish.yml passes -p:Version), so these only
         label builds that are not releases: 0.0.0-dev locally, 0.0.0-ci.<run> from CI. -->
    <VersionPrefix>0.0.0</VersionPrefix>
    <VersionSuffix>dev</VersionSuffix>

    <PackageId>McNeel.Owl</PackageId>
    <Authors>McNeel</Authors>
    <Description>API documentation generator and website builder for .NET</Description>
    <RepositoryUrl>https://github.com/mcneel/Owl</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageIcon>icon.png</PackageIcon>
    <!-- The repo's own README, so nuget.org shows what GitHub does. Its links and icon are full
         urls for that reason: nuget.org cannot follow a path into the repository. -->
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <DebugType Condition="'$(Configuration)' == 'Release'">none</DebugType>

    <!-- owl targets net8.0, and a machine whose newest runtime is 9 or 10 would otherwise refuse
         to start the tool rather than roll forward to what it has. -->
    <RollForward>LatestMajor</RollForward>
  </PropertyGroup>

  <!--
    owl ships as a .NET tool and nothing else: one framework-dependent, RID-agnostic package of
    about 3.5 MB that serves every platform, resolved against the SDK the machine already has.

    That SDK is not an extra ask. owl-gen shells out to 'dotnet msbuild' to learn what a project
    compiles, so anything able to run owl at all already has one, and carrying a runtime as well
    would hand it a second copy of what it has.
  -->
  <ItemGroup>
    <None Include="../art/icon.png" Pack="true" PackagePath="" Visible="false" />
    <None Include="../README.md" Pack="true" PackagePath="" Visible="false" />
  </ItemGroup>

  <PropertyGroup>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>owl</ToolCommandName>
  </PropertyGroup>

</Project>
